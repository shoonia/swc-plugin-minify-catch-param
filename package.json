{
  "name": "swc-plugin-minify-catch-param",
  "version": "0.1.1",
  "description": "A SWC plugin to minify unused catch parameters",
  "type": "module",
  "main": "index.wasm",
  "exports": {
    ".": "./index.wasm"
  },
  "files": [
    "index.wasm"
  ],
  "scripts": {
    "build": "sh build.sh",
    "test:rust": "cargo test",
    "test:smoke": "node tests/smoke/run.mjs",
