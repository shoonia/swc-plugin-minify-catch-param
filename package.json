    "fixture": "UPDATE=1 cargo test --test fixture",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2"
  },
  "peerDependencies": {
    "@swc/core": "^1.16.2"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    }
  },
  "author": {
    "name": "Alexander Zaytsev",
    "email": "zaytsev126@gmail.com",
